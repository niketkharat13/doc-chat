### Copy this file to .env and fill in real values. Do NOT commit secrets.

# PostgreSQL connection (example):
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_URL=

# Embedding/vector dimension used by your vector DB (adjust as needed)
EMBEDDING_DIM=3072

# Google service account key file path (if using Google APIs locally)
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini / LLM API key or other LLM provider key
GEMINI_API_KEY=

# Application settings
SECRET_KEY=change-me
BACKEND_PORT=8000
